# TradeFlow Platform Environment Configuration Example
# Copy this file to .env and fill in your actual secrets and credentials.

# Django Security & Core Settings
SECRET_KEY=django-insecure-tradeflow-local-dev-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Local PostgreSQL)
DB_NAME=tradeflow
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration (Local Redis)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Channels / WebSockets Layer Configuration
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer
CHANNEL_LAYERS_HOSTS=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
